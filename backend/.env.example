# Required to start the API
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://chamber:chamber@localhost:5432/chamber_management?schema=public&connection_limit=10"
REDIS_URL="redis://localhost:6379"

# Application
APP_NAME="Chamber Management API"
APP_URL="http://localhost:3000"
ENABLE_SWAGGER=true
LOG_LEVEL=log
TIMEZONE=Asia/Dhaka
# Browser origins allowed to call the API. Keep unset for server-to-server-only deployments.
CORS_ORIGINS=
# Set only behind a managed reverse proxy that correctly overwrites X-Forwarded-For.
TRUST_PROXY=false
# Coarse per-IP protection for all API routes; authentication has stricter independent limits.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# Required to expose the protected Prometheus scrape endpoint at /api/metrics.
METRICS_TOKEN=

# Test database (used by `npm run test:infra`)
DATABASE_URL_TEST="postgresql://chamber:chamber@localhost:5432/chamber_management_test?schema=public&connection_limit=5"

# Sprint 2+ configuration stubs. Set real secrets only in a local/hosted .env file.
JWT_ACCESS_SECRET="development-only-access-secret-replace-before-production"
JWT_REFRESH_SECRET="development-only-refresh-secret-replace-before-production"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
# Optional email delivery (used for notification channels, not the primary OTP factor).
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Set true only for an implicit-TLS relay, typically port 465. Port 587 uses STARTTLS.
EMAIL_SMTP_SECURE=false
# SMS OTP delivery. Production requires a configured provider.
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
NOTIFICATIONS_ENABLED=false
PUSH_ENABLED=false
PUSH_WEBHOOK_URL=
