# Required to start the API
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://chamber:chamber@localhost:5432/chamber_management?schema=public&connection_limit=10"
REDIS_URL="redis://localhost:6379"

# Application
APP_NAME="Chamber Management API"
APP_URL="http://localhost:3000"
ENABLE_SWAGGER=true
LOG_LEVEL=log
TIMEZONE=Asia/Dhaka

# Test database (used by `npm run test:infra`)
DATABASE_URL_TEST="postgresql://chamber:chamber@localhost:5432/chamber_management_test?schema=public&connection_limit=5"

# Sprint 2+ configuration stubs. Set real secrets only in a local/hosted .env file.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
AI_PROVIDER=
AI_API_KEY=
EMAIL_PROVIDER=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
NOTIFICATIONS_ENABLED=false
